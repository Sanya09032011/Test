# ═══════════════════════════════════════════════════════════════
#  КЛЮЧ ELEVENLABS  (файл .env у корені папки AI-Montazher)
#  Ключ: elevenlabs.io → Developers → API Keys → Create API Key → Copy
#  Не показуй цей файл нікому і не заливай в інтернет.
# ═══════════════════════════════════════════════════════════════

# Твій API-ключ ElevenLabs (починається з sk_...) — потрібен для субтитрів і озвучки
ELEVENLABS_API_KEY=

# ID голосу для роликів з озвучкою: твій клон або голос з бібліотеки (Voices → відкрий голос → Copy voice ID)
ELEVENLABS_VOICE_ID=NqnAfUWnI3QyhwAZ3Yj6

# Модель озвучки: eleven_v4 — дешевша, розуміє емоційні теги в [дужках], добре тримає українську
ELEVENLABS_MODEL=eleven_v4
